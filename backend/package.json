{
  "name": "agama-render-wrapper",
  "version": "1.0.0",
  "private": true,
  "description": "Compatibility wrapper for Render deployments that expect a backend directory.",
  "scripts": {
    "install-server-deps": "npm --prefix ../server install --no-audit --no-fund",
    "build-frontend": "echo \"No frontend build step required\"",
    "start": "node ../server/index.js",
    "postinstall": "npm run install-server-deps"
  }
}
