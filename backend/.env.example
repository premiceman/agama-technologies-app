# ===== Agama Technologies — Environment Variables (.env example) =====
# Core
PORT=3000
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<dbName>?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_me_with_a_long_random_string
JWT_COOKIE_NAME=at_session
JWT_EXPIRES_DAYS=7

# CORS / Allowed origins (comma-separated). e.g., https://www.agamatechnologies.com,http://localhost:5173
ALLOWED_ORIGINS=https://www.agamatechnologies.com,https://agamatechnologies.com

# App metadata (optional)
APP_BASE_URL=https://www.agamatechnologies.com
