# ===== Agama Technologies — Environment Variables (.env example) =====
# Core
PORT=3000
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<dbName>?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_me_with_a_long_random_string
JWT_COOKIE_NAME=at_session
JWT_EXPIRES_DAYS=7

# CORS / Allowed origins (comma-separated). e.g., https://www.agamatechnologies.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://www.agamatechnologies.com

# App metadata (optional)
APP_BASE_URL=https://www.agamatechnologies.com

# WorkOS
WORKOS_API_KEY=sk_example_123
WORKOS_CLIENT_ID=client_example_123
WORKOS_REDIRECT_URI=https://www.agamatechnologies.com/api/auth/workos/callback
WORKOS_SUCCESS_REDIRECT=https://www.agamatechnologies.com/workspace.html
WORKOS_LOGOUT_REDIRECT=https://www.agamatechnologies.com
WORKOS_PORTAL_RETURN_URL=https://www.agamatechnologies.com/workspace.html
